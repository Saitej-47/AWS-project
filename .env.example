NODE_ENV=development
AUTH_MODE=demo
PORT=3001
APP_ORIGIN=http://localhost:3000
DATA_DIRECTORY=.
SESSION_SECRET=replace-with-a-long-random-secret
# Optional in development; required in production for MySQL-backed accounts.
DATABASE_URL=

# Google Cloud OAuth 2.0 Web Application credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Production email delivery uses SendGrid. In development, reset links are
# returned as development-only tokens when email is not configured.
EMAIL_PROVIDER=disabled
EMAIL_FROM=
SENDGRID_API_KEY=

# Set to true only when deployed behind one trusted reverse proxy.
TRUST_PROXY=false

# AWS SDK uses the standard backend credential provider chain (environment,
# shared profile, container credentials, or instance/workload role).
AWS_REGION=ap-south-1
AWS_COST_EXPLORER_REGION=us-east-1
AWS_CLOUDWATCH_PERIOD_SECONDS=3600
AWS_CLOUDWATCH_LOOKBACK_HOURS=24
AWS_COST_LOOKBACK_DAYS=30